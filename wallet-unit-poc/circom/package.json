{
  "name": "@privacy-scaling-explorations/zkid-circom",
  "description": "circom circuits for verifying X.509 RSA-SHA256 certificate chains with revocation",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/privacy-scaling-explorations/zkID"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--max-old-space-size=16384 npx mocha",
    "test:user_sig": "NODE_OPTIONS=--max-old-space-size=16384 npx mocha tests/circuits/userSigRS2048.test.ts",
    "test:cert_chain_2048": "NODE_OPTIONS=--max-old-space-size=16384 npx mocha tests/circuits/certChainRS2048.test.ts",
    "test:cert_chain_4096": "NODE_OPTIONS=--max-old-space-size=16384 npx mocha tests/circuits/certChainRS4096.test.ts",
    "test:linking": "NODE_OPTIONS=--max-old-space-size=16384 npx mocha tests/circuits/pk_commit_linking.test.ts",
    "compile:certChainRS2048": "bash scripts/compile.sh certChainRS2048",
    "compile:certChainRS4096": "bash scripts/compile.sh certChainRS4096",
    "compile:userSigRS2048": "bash scripts/compile.sh userSigRS2048",
    "compile:all": "bash scripts/compile.sh all",
    "copy:circuits": "bash scripts/compile.sh copy"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@types/asn1": "^0.2.4",
    "@zk-email/circuits": "^6.3.3-nightly-20250214",
    "@zk-email/helpers": "^6.4.2",
    "asn1": "^0.2.6",
    "base64-js": "^1.5.1",
    "bs58": "^6.0.0",
    "circom_tester": "^0.0.21",
    "circomkit": "^0.3.4",
    "circomlib": "^2.0.5",
    "did-resolver": "^4.1.0",
    "jose": "^6.0.10",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "jws": "^4.0.0",
    "key-did-resolver": "^4.0.0",
    "mocha": "^11.1.0",
    "safe-buffer": "^5.2.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.1.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
